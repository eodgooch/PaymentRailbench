# Copy to .env for local overrides. Never commit .env.
DATABASE_URL=postgresql+psycopg://railbench:railbench@localhost:5432/railbench
LEDGER_READONLY_DATABASE_URL=     # SELECT-only role, used by the MCP server and agent
LEDGER_DATABASE_ROLE=railbench_app  # the Ledger API's SET ROLE: SELECT and INSERT only
SIMULATOR_URL=http://localhost:8100
LEDGER_WEBHOOK_URL=http://localhost:8000/providers/simulator/events  # where the Simulator delivers Provider Events
WEBHOOK_SIGNING_SECRET=change-me
ANTHROPIC_API_KEY=                # optional; agent steps skip when unset
TRIAGE_MODEL=                     # set from current Anthropic docs
TRIAGE_COST_CAP_NIGHT_USD=1
TRIAGE_COST_CAP_EVAL_USD=10
INSTANT_PAYOUT_LIMIT_CENTS=500000
CASH_ADVANCE_BPS=6000
LOAN_APR_BPS=1200
LOG_LEVEL=INFO
SIMULATOR_TICK_SECONDS=0          # >0: the Simulator settles Payments and delivers webhooks this often
LEDGER_TICK_SECONDS=0             # >0: the Ledger makes due ACH funds Available this often
